<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>luxo_behaviors</name>
  <version>0.1.0</version>
  <description>LuxoPI movement, shared sensor behaviors, local speech integration and hardware-free simulation</description>
  <maintainer email="cyril@thegarage.dev">pi</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>cv_bridge</depend>
  <depend>luxo_interfaces</depend>
  <depend>action_msgs</depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
